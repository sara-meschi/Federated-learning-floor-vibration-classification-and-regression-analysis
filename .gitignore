*.pt
artifacts/*.pt
TestData/
__pycache__/
*.pyc
wandb/
artifacts/_r1_evidence_readonly_backup/
# S3 R1 sweep: per-run outputs stay local; the table and summary are the record.
artifacts/s3_r1_sweep/*
!artifacts/s3_r1_sweep/sweep_table.md
!artifacts/s3_r1_sweep/sweep_summary.json
# S5 queue: per-job outputs stay local; the index, status log and derived tables are the record.
artifacts/s5/*
!artifacts/s5/results_index.csv
!artifacts/s5/status.log
!artifacts/s5/derived/
# Relabel (8 identities): per-job outputs stay local; the index, status log, derived
# tables, step-2 checks, re-scores and the artifact summary/manifest are the record.
artifacts/relabel/*
!artifacts/relabel/results_index.csv
!artifacts/relabel/status.log
!artifacts/relabel/derived/
!artifacts/relabel/checks/
!artifacts/relabel/rescore/
!artifacts/relabel/data/
